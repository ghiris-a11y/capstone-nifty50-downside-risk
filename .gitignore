# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Data and models (per PROJECT_PLAN P0)
data/raw/*
!data/raw/.gitkeep
!data/raw/repo_rate.csv
!data/raw/cpi.csv
!data/raw/iip.csv
!data/raw/templates/
outputs/models/*
!outputs/models/.gitkeep

# Frontend
frontend/node_modules/
frontend/dist/

# Private documents: kept locally, not published in this public repo
Capstone notes.docx
Phase1_Report_CAP_final.pdf
report/template/*
!report/template/.gitkeep
~$*

# Editors / OS / local tool settings
.vscode/
.claude/settings.local.json
Thumbs.db
desktop.ini

# Pilot / data files not for the public repo
outputs/demo/
data/processed/pilot_snapshot/*.parquet
data/processed/sensitivity_snapshot/*.parquet
report/pilot_pitch.docx
report/pilot_pitch.pdf

# Frozen Yahoo prices stay local (Yahoo terms); the hash manifest is committed
data/frozen/*.parquet
outputs/tables/**/by_ticker/**/*__daily.parquet
outputs/dashboard_check/*.png

# Final report files carry the ITM logo: kept local like the Phase 1 PDF
report/Phase2_Report.docx
report/Phase2_Report.pdf
report/page_previews/
# Demo-mode outputs written to the outputs/ root by --demo
outputs/*_vix_macro.csv
report/figures/_trimmed/

# third-party Figma reference screenshots (licence not confirmed): keep local only
design/figma/*.png
